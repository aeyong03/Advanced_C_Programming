{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Compile current file (GCC)",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-finput-charset=UTF-8",
                "-fexec-charset=EUC-KR",
                "${fileBasename}",
                "-o",
                "${fileBasenameNoExtension}_build.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
